/**
 * @fileoverview Firestore Security Rules for ExamPrep platform.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Users can only access
 * their own profile data and the practice sessions associated with their account.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information. The userId must match
 *   the Firebase Auth UID.
 * - /questions/{questionId}: Stores public question data. Read access is
 *   unrestricted. Write access is disallowed.
 * - /users/{userId}/practiceSessions/{practiceSessionId}: Stores practice session
 *   data for individual users. The userId in the path must match the
 *   'userId' field within the document.
 * - /users/{userId}/practiceSessions/{practiceSessionId}/questionSessions/{questionSessionId}:
 *   Stores individual question sessions nested under practice sessions.
 *   Inherits ownership from the parent practice session.
 *
 * Key Security Decisions:
 * - Users can only list their own practice sessions.
 * - Users can only create practice sessions under their own user ID.
 * - Questions are read-only and cannot be created, updated, or deleted via the
 *   client.
 *
 * Denormalization for Authorization:
 * - The 'PracticeSession' documents denormalize the 'userId' field to enable
 *   authorization checks without additional 'get()' calls.
 *
 * Structural Segregation:
 * - User-specific data (practice sessions) is stored in a subcollection
 *   under the user's document, ensuring private data is not mixed with public
 *   data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' can create their profile.
     * @deny (create) User with UID 'otherUserId' cannot create a profile with ID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3'.
     * @allow (get) User with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' can read their profile.
     * @deny (get) User with UID 'otherUserId' cannot read user with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' profile.
     * @allow (update) User with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' can update their profile.
     * @deny (update) User with UID 'otherUserId' cannot update user with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' profile.
     * @allow (delete) User with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' can delete their profile.
     * @deny (delete) User with UID 'otherUserId' cannot delete user with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to question documents.
     * @path /questions/{questionId}
     * @allow (get) Any user can read any question.
     * @allow (list) Any user can list questions.
     * @deny (create) No user can create a question.
     * @deny (update) No user can update a question.
     * @deny (delete) No user can delete a question.
     * @principle Questions are read-only for clients.
     */
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to practice session documents.
     * @path /users/{userId}/practiceSessions/{practiceSessionId}
     * @allow (create) User with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' can create a practice session under their ID.
     * @deny (create) User with UID 'otherUserId' cannot create a practice session under user ID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3'.
     * @allow (get) User with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' can read their practice session.
     * @deny (get) User with UID 'otherUserId' cannot read user with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' practice session.
     * @allow (list) User with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' can list practice sessions under their ID.
     * @deny (list) User with UID 'otherUserId' cannot list practice sessions under user ID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3'.
     * @allow (update) User with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' can update their practice session.
     * @deny (update) User with UID 'otherUserId' cannot update user with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' practice session.
     * @allow (delete) User with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' can delete their practice session.
     * @deny (delete) User with UID 'otherUserId' cannot delete user with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' practice session.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/practiceSessions/{practiceSessionId} {
      allow get: if isOwner(userId) && resource.data.userId == userId;
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == userId;
      allow delete: if isExistingOwner(userId) && resource.data.userId == userId;
    }

    /**
     * @description Controls access to question session documents within a practice session.
     * @path /users/{userId}/practiceSessions/{practiceSessionId}/questionSessions/{questionSessionId}
     * @allow (get) User with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' can read a question session within their practice session.
     * @deny (get) User with UID 'otherUserId' cannot read a question session within user 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' practice session.
     * @allow (list) User with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' can list question sessions within their practice session.
     * @deny (list) User with UID 'otherUserId' cannot list question sessions within user 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' practice session.
     * @allow (create) User with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' can create a question session within their practice session.
     * @deny (create) User with UID 'otherUserId' cannot create a question session within user 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' practice session.
     * @allow (update) User with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' can update a question session within their practice session.
     * @deny (update) User with UID 'otherUserId' cannot update a question session within user 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' practice session.
     * @allow (delete) User with UID 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' can delete a question session within their practice session.
     * @deny (delete) User with UID 'otherUserId' cannot delete a question session within user 'iAdMpf9VnlQBQRmAV8szqi1VZxI3' practice session.
     * @principle Enforces document ownership and inheritance from parent PracticeSession.
     */
    match /users/{userId}/practiceSessions/{practiceSessionId}/questionSessions/{questionSessionId} {
      allow get: if isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)/practiceSessions/$(practiceSessionId)).data.userId == userId;
      allow list: if isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)/practiceSessions/$(practiceSessionId)).data.userId == userId;
      allow create: if isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)/practiceSessions/$(practiceSessionId)).data.userId == userId;
      allow update: if isExistingOwner(userId) && get(/databases/$(database)/documents/users/$(userId)/practiceSessions/$(practiceSessionId)).data.userId == userId;
      allow delete: if isExistingOwner(userId) && get(/databases/$(database)/documents/users/$(userId)/practiceSessions/$(practiceSessionId)).data.userId == userId;
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}